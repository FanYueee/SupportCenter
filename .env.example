SUPPORT_DOMAIN=support.atomroute.com
# Use 8080 while the acceptance site holds the Tunnel's 8082 route; switch to 8082 at cutover.
SUPPORT_BIND_PORT=8080
# Use a long random URL-safe value; e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-random-hex
AUTH0_DOMAIN=sso.atomroute.com
AUTH0_CLIENT_ID=fy2JX5io93Y4gVYm3TnNInmz9UP07adV
AUTH0_CLIENT_SECRET=
# Enable only after placing the OpenCode Go API key in .env on the VPS.
AI_AUTO_REPLY_ENABLED=false
OPENCODE_GO_API_KEY=
# Optional. Technical-department notifications remain queued until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
# The Compose file derives APP_URL and DATABASE_URL. For running Go directly:
# APP_URL=https://support.example.com
# DATABASE_URL=postgres://support:password@127.0.0.1:5432/support?sslmode=disable
# ATTACHMENT_DIR=/var/lib/support-center/attachments
# LISTEN_ADDR=127.0.0.1:8080
