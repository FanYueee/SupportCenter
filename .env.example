SUPPORT_DOMAIN=support.example.com
# Use 8080 while the acceptance site holds the Tunnel's 8082 route; switch to 8082 at cutover.
SUPPORT_BIND_PORT=8080
# Use a long random URL-safe value; e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-random-hex
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# How the site presents itself; all optional. Without a name, pages say only 支援中心.
# e.g. SITE_NAME=Example Cloud
SITE_NAME=
# Footer copyright holder (defaults to SITE_NAME) and the address it links to.
SITE_OWNER=
SITE_WEBSITE=
# PNG, JPEG or WebP files placed in branding/ next to compose.yaml, at most 1 MiB each:
# a wide logo for the header and a square icon for phones and the browser tab,
# e.g. SITE_LOGO=/branding/logo.png and SITE_ICON=/branding/icon.png.
SITE_LOGO=
SITE_ICON=
# Enable only after placing the OpenAI API key in .env (scripts/set-openai-key.sh).
AI_AUTO_REPLY_ENABLED=false
OPENAI_API_KEY=
# Optional; defaults to gpt-6-luna.
OPENAI_MODEL=
# Optional. Customer and technical-department emails; set with scripts/set-smtp.sh.
# Without SMTP, technical notifications wait up to 7 days and customer emails are not queued.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
# The Compose file derives APP_URL and DATABASE_URL. For running Go directly:
# APP_URL=https://support.example.com
# DATABASE_URL=postgres://support:password@127.0.0.1:5432/support?sslmode=disable
# ATTACHMENT_DIR=/var/lib/support-center/attachments
# LISTEN_ADDR=127.0.0.1:8080
