package web

import "strconv"

// Email clients ignore stylesheets and many ignore div widths, so the layout is
// tables with inline styles only.
templ customerEmail(v EmailView) {
	<!DOCTYPE html>
	<html lang="zh-Hant">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light"/>
			<meta name="supported-color-schemes" content="light"/>
			<title>{ v.Heading }</title>
		</head>
		<body style="margin:0;padding:0;background:#f4f4f4;color:#242424;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang TC','Noto Sans TC','Microsoft JhengHei',sans-serif;-webkit-text-size-adjust:100%;">
			if len(v.Intro) > 0 {
				<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#f4f4f4;font-size:1px;line-height:1px;mso-hide:all;">{ v.Intro[0] }</div>
			}
			<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f4;">
				<tr>
					<td align="center" style="padding:36px 16px 40px;">
						<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
							<tr>
								<td style="padding:0 4px 20px;">
									if v.Logo != "" {
										<img src={ v.Logo } width={ strconv.Itoa(v.LogoWidth) } height={ strconv.Itoa(v.LogoHeight) } alt={ v.Site } style="display:block;border:0;outline:none;max-width:100%;height:auto;color:#242424;font-size:17px;font-weight:600;"/>
									} else {
										<span style="font-size:17px;font-weight:600;color:#242424;">{ v.Site }</span>
									}
								</td>
							</tr>
							<tr>
								<td style="background:#ffffff;border:1px solid #e2e2e2;border-radius:14px;">
									<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
										if v.Accent != "" {
											<tr>
												<td style={ emailTopStyle(v) }>&nbsp;</td>
											</tr>
										}
										<tr>
											<td style="padding:32px 32px 28px;">
												if v.Label != "" {
													<table role="presentation" cellpadding="0" cellspacing="0" border="0">
														<tr>
															<td style={ emailLabelStyle(v) }>{ v.Label }</td>
														</tr>
													</table>
												}
												<h1 style="margin:16px 0 12px;font-size:22px;line-height:1.45;font-weight:700;color:#1d1d1d;">{ v.Heading }</h1>
												for _, line := range v.Intro {
													<p style="margin:0 0 10px;font-size:15px;line-height:1.75;color:#3d3d3d;">{ line }</p>
												}
												if len(v.Details) > 0 {
													<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0 4px;background:#f7f7f7;border-radius:10px;">
														<tr>
															<td style="padding:12px 18px;">
																<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
																	for _, d := range v.Details {
																		<tr>
																			<td width="76" style="width:76px;padding:6px 0;font-size:13px;line-height:1.6;color:#6b6b6b;vertical-align:top;white-space:nowrap;">{ d.Label }</td>
																			<td style="padding:6px 0;font-size:14px;line-height:1.6;font-weight:600;color:#242424;overflow-wrap:anywhere;word-break:break-word;">{ d.Value }</td>
																		</tr>
																	}
																</table>
															</td>
														</tr>
													</table>
												}
												if v.Quote != "" {
													<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0 4px;border:1px solid #e6e6e6;border-radius:10px;">
														<tr>
															<td style="padding:16px 18px 18px;">
																<table role="presentation" cellpadding="0" cellspacing="0" border="0">
																	<tr>
																		<td width="32" height="32" align="center" style={ emailAvatarStyle(v) }>{ emailInitial(v.QuoteAuthor) }</td>
																		<td style="padding-left:10px;font-size:14px;line-height:1.4;font-weight:600;color:#242424;">{ v.QuoteAuthor }</td>
																	</tr>
																</table>
																<div style="margin-top:12px;font-size:15px;line-height:1.75;color:#2a2a2a;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;">{ v.Quote }</div>
															</td>
														</tr>
													</table>
												}
												if v.Note != "" {
													<p style="margin:14px 0 0;font-size:14px;line-height:1.7;color:#6b6b6b;">{ v.Note }</p>
												}
												<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:26px;">
													<tr>
														<td style={ emailButtonCellStyle(v) }>
															<a href={ templ.SafeURL(v.Link) } style="display:inline-block;padding:13px 26px;font-size:15px;line-height:1.2;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;">{ v.Action }</a>
														</td>
													</tr>
												</table>
											</td>
										</tr>
										<tr>
											<td style="padding:16px 32px 20px;border-top:1px solid #eeeeee;font-size:12px;line-height:1.7;color:#8a8a8a;">
												按鈕無法開啟時，請複製這個網址到瀏覽器：
												<br/>
												<a href={ templ.SafeURL(v.Link) } style="color:#6b6b6b;text-decoration:underline;word-break:break-all;">{ v.Link }</a>
											</td>
										</tr>
									</table>
								</td>
							</tr>
							<tr>
								<td style="padding:24px 4px 0;font-size:12px;line-height:1.8;color:#8a8a8a;">
									這是系統自動寄出的通知，請勿直接回覆。
									if v.SettingsURL != "" {
										<br/>
										不想收到客服單通知，可在<a href={ templ.SafeURL(v.SettingsURL) } style="color:#6b6b6b;text-decoration:underline;">個人設定</a>關閉。
									}
									if v.Owner != "" || v.Website != "" {
										<br/>
									}
									if v.Owner != "" {
										© { emailYear(v) } { v.Owner }
									}
									if v.Owner != "" && v.Website != "" {
										<span style="color:#c4c4c4;">&nbsp;·&nbsp;</span>
									}
									if v.Website != "" {
										<a href={ templ.SafeURL(v.Website) } style="color:#6b6b6b;text-decoration:underline;">{ v.WebsiteName }</a>
									}
								</td>
							</tr>
						</table>
					</td>
				</tr>
			</table>
		</body>
	</html>
}
