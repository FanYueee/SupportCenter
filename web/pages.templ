package web

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"
	"supportcenter/internal/i18n"
	"supportcenter/internal/model"
)

func choose(b bool, yes, no string) string {
	if b {
		return yes
	}
	return no
}

func ticketURL(p model.Page, id int64) string {
	prefix := "/tickets/"
	if p.Admin {
		prefix = "/admin/tickets/"
	}
	return prefix + strconv.FormatInt(id, 10)
}
func activityTicketURL(u model.User, id int64) string {
	if u.Staff() {
		return "/admin/tickets/" + strconv.FormatInt(id, 10)
	}
	return "/tickets/" + strconv.FormatInt(id, 10)
}
func accountPageURL(logins, activity int) string {
	return "/account?logins=" + strconv.Itoa(logins) + "&activity=" + strconv.Itoa(activity)
}
func usersPageURL(query string, page int) string {
	return "/admin/users?" + (url.Values{"q": {query}, "page": {strconv.Itoa(page)}}).Encode()
}
func avatarURL(ticketID, authorID int64) string {
	return "/tickets/" + strconv.FormatInt(ticketID, 10) + "/avatars/" + strconv.FormatInt(authorID, 10)
}
func ticketPersonAvatarURL(ticketID, personID int64) string {
	return "/admin/tickets/"+strconv.FormatInt(ticketID,10)+"/people/"+strconv.FormatInt(personID,10)+"/avatar"
}
func listURL(p model.Page) string {
	if p.Admin {
		return "/admin/tickets"
	}
	return "/tickets"
}
func filterURL(p model.Page, status string, page int) string {
	values := url.Values{"status": {status}, "q": {p.Query}, "page": {strconv.Itoa(page)}}
	values.Set("phase",p.Phase)
	if p.Sort!="" { values.Set("sort",p.Sort) }
	if p.Admin && p.PriorityFilter != "" {
		values.Set("priority", p.PriorityFilter)
	}
	if p.Admin && p.Assignment != "" {
		values.Set("assigned", p.Assignment)
	}
	return listURL(p) + "?" + values.Encode()
}
func phaseURL(p model.Page, phase string) string {
	p.Phase=phase
	return filterURL(p,"",1)
}
func priorityURL(p model.Page, priority string) string {
	p.PriorityFilter=priority
	return filterURL(p,p.Filter,1)
}
type statusFilter struct { Value, Label string; Count int }
func statusFilters(p model.Page) []statusFilter {
	count := p.Counts.All-p.Counts.Solved-p.Counts.Closed
	if p.Phase=="done" { count=p.Counts.Solved+p.Counts.Closed }
	filters := []statusFilter{{"","全部",count}}
	if p.Phase=="done" {
		return append(filters,statusFilter{"solved","已解決",p.Counts.Solved},statusFilter{"closed","已結案",p.Counts.Closed})
	}
	if p.Admin {
		return append(filters,
			statusFilter{"new","尚未受理",p.Counts.New},
			statusFilter{"open","處理中",p.Counts.Open},
			statusFilter{"waiting","等待使用者回覆",p.Counts.Waiting},
			statusFilter{"on_hold","等待其他單位回覆",p.Counts.Hold})
	}
	return append(filters,
		statusFilter{"new","待受理",p.Counts.New},
		statusFilter{"open","處理中",p.Counts.Open},
		statusFilter{"waiting","待您回覆",p.Counts.Waiting})
}
func displayedRanges(ranges []model.TimeRange) []model.TimeRange {
	if len(ranges) == 0 {
		return []model.TimeRange{{}}
	}
	return ranges
}
func leaveInputTime(at *time.Time, timezone string) string {
	if at == nil { return "" }
	loc, err := time.LoadLocation(timezone)
	if err != nil { return "" }
	return at.In(loc).Format("2006-01-02T15:04")
}
func teamHas(ticket model.Ticket, userID int64) bool {
	for _,user:=range ticket.Team { if user.ID==userID { return true } }
	return false
}
func hasOtherStaff(staff []model.User, userID int64) bool {
	for _, user := range staff { if user.ID != userID { return true } }
	return false
}
func departmentOrder(category string) []model.Department {
	if category == "account" { category = "other" }
	ordered := make([]model.Department,0,len(model.Departments))
	for _, department := range model.Departments { if department.Category == category { ordered=append(ordered,department) } }
	for _, department := range model.Departments { if department.Category != category { ordered=append(ordered,department) } }
	return ordered
}
func hasDepartmentStaff(staff []model.User, category string, viewerID int64) bool {
	for _, person := range staff { if person.ID != viewerID && person.InDepartment(category) { return true } }
	return false
}
func hasUngroupedStaff(staff []model.User, viewerID int64) bool {
	for _, person := range staff { if person.ID != viewerID && len(person.Departments)==0 { return true } }
	return false
}
func teamLabel(ticket model.Ticket) string {
	if len(ticket.Team)==0 { return "等待指派" }
	names:=make([]string,0,len(ticket.Team))
	for _,user:=range ticket.Team { names=append(names,user.Name) }
	return strings.Join(names,"、")
}

templ Icon(name string) {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
		switch name {
			case "ticket":
				<path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4V5Z M15 5v14"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "search":
				<circle cx="10.5" cy="10.5" r="6.5"></circle>
				<path d="m16 16 5 5"></path>
			case "arrow":
				<path d="M5 12h14m-5-5 5 5-5 5"></path>
			case "back":
				<path d="M19 12H5m5-5-5 5 5 5"></path>
			case "check":
				<path d="m5 13 4 4L19 7"></path>
			case "clock":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M12 7v5l3 2"></path>
			case "bell":
				<path d="M6 9a6 6 0 0 1 12 0v6l2 3H4l2-3V9Zm4 12h4"></path>
			case "info":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M12 11v6m0-10v1"></path>
			case "warning":
				<path d="m12 3 10 18H2L12 3Zm0 6v5m0 3v1"></path>
			case "status-open":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="m10 8 5 4-5 4V8Z"></path>
			case "status-new":
				<path d="M4 5h16v14H4z M8 9h8m-8 6h5"></path>
			case "status-hold":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M10 8v8m4-8v8"></path>
			case "status-solved":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="m8 12 3 3 5-6"></path>
			case "assistant":
				<path d="m12 4 2 6 6 2-6 2-2 6-2-6-6-2 6-2 2-6Z"></path>
			case "file":
				<path d="M6 3h8l4 4v14H6V3Zm8 0v5h4M9 12h6m-6 4h6"></path>
			case "category-technical":
				<path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16"></path>
			case "category-billing":
				<path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Zm3 5h6m-6 4h6"></path>
			case "category-other", "category-account":
				<path d="M4 5h16v12H9l-5 4V5Zm4 4h8m-8 4h5"></path>
			case "login":
				<path d="M14 4h6v16h-6M3 12h12m-4-4 4 4-4 4"></path>
			case "logout":
				<path d="M10 4H4v16h6m-1-8h12m-4-4 4 4-4 4"></path>
			case "shield":
				<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z m-4 9 3 3 5-6"></path>
			case "sun":
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1"></path>
			case "moon":
				<path d="M20 15.5A8.5 8.5 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5Z"></path>
			default:
				<path d="M4 5h16v12H9l-5 4V5Z M8 9h8m-8 4h5"></path>
		}
	</svg>
}

templ FlagIcon(locale string) {
	<svg class="flag-icon" viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
		if locale == "zh-Hant" {
			<rect width="24" height="16" fill="#e60026"/>
			<rect width="12" height="8" fill="#002b7f"/>
			<circle cx="6" cy="4" r="1.35" fill="#fff"/>
			<path d="M6 1v1M6 6v1M3 4h1m4 0h1M3.9 1.9l.7.7m2.8 2.8.7.7m0-4.2-.7.7m-2.8 2.8-.7.7" stroke="#fff" stroke-width=".7" stroke-linecap="round"/>
		} else {
			<rect width="24" height="16" fill="#fff"/>
			<path d="M0 0h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.24H0z" fill="#b22234"/>
			<rect width="10" height="8.61" fill="#3c3b6e"/>
			<path d="M1.5 1.4h7m-6.2 1.4h5.4m-6.2 1.4h7m-6.2 1.4h5.4m-6.2 1.4h7" stroke="#fff" stroke-width=".7" stroke-linecap="round" stroke-dasharray=".1 1.3"/>
		}
	</svg>
}

templ Document(p model.Page) {
	<!DOCTYPE html>
	<html lang={ i18n.Lang(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="htmx-config" content='{"selfRequestsOnly":true,"allowScriptTags":false,"allowEval":false,"historyCacheSize":0,"includeIndicatorStyles":false}'/>
			<title>{ pageTitle(ctx,p) } · { i18n.T(ctx,"AtomRoute 支援中心") }</title>
			<link rel="icon" type="image/png" href={ assetURL(brandOf(ctx).Icon) }/>
			<script src={ assetURL("theme.js") }></script>
			<link rel="stylesheet" href={ assetURL("app.css") }/>
			if p.Active != "login" {
				<script src={ assetURL("htmx.min.js") } defer></script>
				<script src={ assetURL("app.js") } defer></script>
			}
		</head>
		<body hx-history="false">
			<a href="#workspace" class="skip-link">{ i18n.T(ctx,"跳到主要內容") }</a>
			if p.Active != "login" {
				<dialog id="image-dialog" class="image-dialog" aria-label={ i18n.T(ctx,"圖片預覽") }>
					<div class="image-dialog-panel">
						<div class="image-dialog-head">
							<strong data-preview-name></strong>
							<button type="button" class="image-dialog-close" data-preview-close aria-label={ i18n.T(ctx,"關閉圖片預覽") }>×</button>
						</div>
						<img data-preview-image alt=""/>
						<div class="image-dialog-actions">
							<a data-preview-open target="_blank" rel="noopener">{ i18n.T(ctx,"另開圖片") }</a>
							<a data-preview-download>{ i18n.T(ctx,"下載原圖") }</a>
						</div>
					</div>
				</dialog>
			}
			<header class="site-header">
				<div class="header-inner">
					<a class="brand" href="/tickets" aria-label={ i18n.T(ctx,"AtomRoute 支援中心") }>
						<picture class={ "brand-image", "brand-" + brandOf(ctx).Key }>
							<source media="(max-width: 760px)" srcset={ assetURL(brandOf(ctx).Icon) }/>
							<img src={ assetURL(brandOf(ctx).Logo) } alt={ brandOf(ctx).LogoAlt } width={ brandOf(ctx).LogoWidth } height={ brandOf(ctx).LogoHeight }/>
						</picture>
						<span class="brand-name" aria-hidden="true">{ brandOf(ctx).Name }</span>
						<span class="brand-divider">/</span><span class="brand-product">{ i18n.T(ctx,"支援中心") }</span>
					</a>
					if p.Active != "login" {
						<nav class="main-nav" aria-label={ i18n.T(ctx,"主選單") }>
							<a class={ "nav-item", templ.KV("selected", !p.Admin && p.Active!="account" && p.Active!="notifications") } href="/tickets">{ i18n.T(ctx,"我的客服單") }</a>
							if p.User.Staff() {
								<a class={ "nav-item", templ.KV("selected", p.Admin && (p.Active=="list" || p.Active=="detail")) } href="/admin/tickets">{ i18n.T(ctx,"客服工作台") }</a>
							}
							if p.User.Role == "admin" {
				<a class={ "nav-item", templ.KV("selected", p.Active=="users" || p.Active=="automation" || p.Active=="ai" || p.Active=="departments" || p.Active=="announcements") } href="/admin/ai">{ i18n.T(ctx,"管理設定") }</a>
							}
						</nav>
					}
					<div class="header-actions">
						<button type="button" class="icon-button theme-toggle" data-theme-toggle data-theme-light-label={ i18n.T(ctx,"切換至淺色模式") } data-theme-dark-label={ i18n.T(ctx,"切換至深色模式") } aria-label={ i18n.T(ctx,"切換深淺色模式") } title={ i18n.T(ctx,"切換深淺色模式") }>
							<span class="theme-icon-sun" aria-hidden="true">@Icon("sun")</span>
							<span class="theme-icon-moon" aria-hidden="true">@Icon("moon")</span>
						</button>
						if p.Active != "login" {
								<a class="icon-button notification-link" href="/notifications" aria-label={ notificationLabel(ctx,p.UnreadNotifications) } title={ i18n.T(ctx,"通知") }>
								@Icon("bell")
								if p.UnreadNotifications>0 {
									<span class="notification-count" aria-hidden="true">{ choose(p.UnreadNotifications>99,"99+",strconv.Itoa(p.UnreadNotifications)) }</span>
								}
								</a>
							<a class="account-identity" href="/account" aria-label={ i18n.T(ctx,"個人設定") } title={ i18n.T(ctx,"個人設定") } aria-current={ choose(p.Active=="account","page","false") }>
								if p.Preview {
									<span class="avatar account-avatar" aria-hidden="true">{ model.Initial(p.User.Name) }</span>
								} else {
									<img class="avatar account-avatar" src="/avatars/me" alt="" width="30" height="30"/>
								}
								<span class="account-name" title={ p.User.Email }>{ p.User.Name }</span>
							</a>
							<form action="/logout" method="post">
								<input type="hidden" name="csrf" value={ p.CSRF }/>
								<button class="icon-button" aria-label={ i18n.T(ctx,"登出") } title={ i18n.T(ctx,"登出") }>
									@Icon("logout")
								</button>
							</form>
						}
					</div>
				</div>
			</header>
			if p.Active == "login" {
				@Login(p)
			} else {
				@Workspace(p)
			}
			@SiteFooter()
		</body>
	</html>
}

templ Workspace(p model.Page) {
	<main id="workspace" class={ "workspace", templ.KV("form-workspace",p.Active=="new") } tabindex="-1">
		@AnnouncementBanners(p.Announcements)
		if p.Preview {
			<div class="preview-banner">{ i18n.T(ctx,"唯讀預覽") }</div>
		}
		<div id="request-error" class="notice error" role="alert" tabindex="-1" hidden></div>
		if p.Error != "" {
			<div class="notice error" role="alert">
				{ i18n.T(ctx,p.Error) }
			</div>
		}
		switch p.Active {
			case "new":
				@NewTicket(p)
			case "detail":
				@Detail(p)
			case "account":
				@Account(p)
			case "notifications":
				@Notifications(p)
			case "users":
				@Users(p)
			case "automation":
				@Automation(p)
			case "ai":
				@AISettings(p)
			case "departments":
				@Departments(p)
			case "announcements":
				@AnnouncementsSettings(p)
			default:
				@List(p)
		}
	</main>
}

templ Badge(status string, staff bool) {
	<span class={ "badge", "badge-"+model.VisibleStatus(status,staff) }>
		if status == "new" {
			@Icon("status-new")
		} else if status == "open" || (status == "on_hold" && !staff) {
			@Icon("status-open")
		} else if status == "waiting" {
			@Icon("clock")
		} else if status == "on_hold" {
			@Icon("status-hold")
		} else if status == "solved" {
			@Icon("status-solved")
		} else if status == "closed" {
			@Icon("check")
		}
		<span class="badge-label">{ i18n.T(ctx,model.StatusForViewer(status, staff)) }</span>
	</span>
}

templ TicketBadge(ticket model.Ticket, staff bool) {
	if ticket.AssistanceMode=="ai" && (ticket.Status=="new" || ticket.Status=="open") {
		<span class="badge badge-ai-processing">
			@Icon("assistant")
			<span class="badge-label">{ i18n.T(ctx,"AI 處理中") }</span>
		</span>
	} else if ticket.AssistanceMode=="ai" && ticket.Status=="waiting" {
		<span class="badge badge-ai-replied">
			@Icon("clock")
			<span class="badge-label">{ i18n.T(ctx,choose(staff,"AI 已回覆 · 待客戶確認","AI 已回覆 · 待您確認")) }</span>
		</span>
	} else {
		@Badge(ticket.Status,staff)
	}
}

templ Priority(priority string) {
	<span class={ "priority", "priority-"+priority }>{ i18n.T(ctx,model.Priority(priority)) }</span>
}

templ Account(p model.Page) {
	<div class="page-heading"><h1>{ i18n.T(ctx,"個人設定") }</h1></div>
	if p.Saved {
		<div class="notice success" role="status">{ i18n.T(ctx,"已儲存") }</div>
	}
	<section class="account-card language-settings" aria-labelledby="language-heading">
		<h2 id="language-heading">{ i18n.T(ctx,"語言") }</h2>
		<form class="language-options" method="post" action="/language">
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<button class={ "locale-button", templ.KV("selected",i18n.Lang(ctx)=="zh-Hant") } type="submit" name="language" value="zh-Hant" aria-pressed={ choose(i18n.Lang(ctx)=="zh-Hant","true","false") }>
				@FlagIcon("zh-Hant")
				<span lang="zh-Hant">繁體中文</span>
				if i18n.Lang(ctx)=="zh-Hant" {
					@Icon("check")
				}
			</button>
			<button class={ "locale-button", templ.KV("selected",i18n.Lang(ctx)=="en") } type="submit" name="language" value="en" aria-pressed={ choose(i18n.Lang(ctx)=="en","true","false") }>
				@FlagIcon("en")
				<span lang="en">English</span>
				if i18n.Lang(ctx)=="en" {
					@Icon("check")
				}
			</button>
		</form>
	</section>
	if p.User.Role == "admin" {
		<div class="account-grid">
			<section class="account-card">
				<h2>{ i18n.T(ctx,"顯示名稱") }</h2>
				<form method="post" action="/account/name">
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					<label class="field">{ i18n.T(ctx,"名稱") }<input name="name" value={ p.User.Name } maxlength="80" required/></label>
					<button class="button secondary" type="submit">{ i18n.T(ctx,"儲存名稱") }</button>
				</form>
			</section>
			<section class="account-card">
				<h2>{ i18n.T(ctx,"簽名檔") }</h2>
				<p class="field-hint">{ i18n.T(ctx,"公開回覆時自動附上") }</p>
				<form method="post" action="/account/signature">
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					<label class="field" for="signature">{ i18n.T(ctx,"內容") }</label>
					<textarea id="signature" name="signature" maxlength="500" rows="4">{ p.User.Signature }</textarea>
					<button class="button secondary" type="submit">{ i18n.T(ctx,"儲存簽名檔") }</button>
				</form>
			</section>
		</div>
	}
	<div class={ "account-grid account-history", templ.KV("standalone-history",p.User.Role!="admin") }>
		<section class="account-card">
			<h2>{ i18n.T(ctx,"登入紀錄") }</h2>
			if len(p.Logins)==0 {
				<p class="field-hint">{ i18n.T(ctx,"尚無紀錄") }</p>
			} else {
				<ol class="history-list">
					for _, entry := range p.Logins {
						<li><span class="history-main"><span>{ activityBrowser(ctx,entry) }</span><span class="history-source" title={ entry.UserAgent }>{ i18n.T(ctx,model.ActivityIP(entry)) }</span></span><time datetime={ entry.CreatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="full" data-timezone-inline>{ entry.CreatedAt.UTC().Format("2006/01/02 15:04") } UTC</time></li>
					}
				</ol>
			}
			<div class="pagination">
				if p.LoginPage>1 {
					<a href={ templ.SafeURL(accountPageURL(p.LoginPage-1,p.ActivityPage)) }>{ i18n.T(ctx,"上一頁") }</a>
				}
				if p.HasMoreLogins {
					<a href={ templ.SafeURL(accountPageURL(p.LoginPage+1,p.ActivityPage)) }>{ i18n.T(ctx,"下一頁") }</a>
				}
			</div>
		</section>
		<section class="account-card">
			<h2>{ i18n.T(ctx,"使用紀錄") }</h2>
			if len(p.Activities)==0 {
				<p class="field-hint">{ i18n.T(ctx,"尚無紀錄") }</p>
			} else {
				<ol class="history-list">
					for _, entry := range p.Activities {
						<li><span class="history-main"><span>
								if entry.TicketID>0 {
									<a href={ templ.SafeURL(activityTicketURL(p.User,entry.TicketID)) }>{ activityText(ctx,entry) } · #{ strconv.FormatInt(entry.TicketID,10) }</a>
								} else {
									{ activityText(ctx,entry) }
								}
							</span><span class="history-source" title={ entry.UserAgent }>{ activityBrowser(ctx,entry) } · { i18n.T(ctx,model.ActivityIP(entry)) }</span></span><time datetime={ entry.CreatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="full" data-timezone-inline>{ entry.CreatedAt.UTC().Format("2006/01/02 15:04") } UTC</time></li>
					}
				</ol>
			}
			<div class="pagination">
				if p.ActivityPage>1 {
					<a href={ templ.SafeURL(accountPageURL(p.LoginPage,p.ActivityPage-1)) }>{ i18n.T(ctx,"上一頁") }</a>
				}
				if p.HasMoreActivities {
					<a href={ templ.SafeURL(accountPageURL(p.LoginPage,p.ActivityPage+1)) }>{ i18n.T(ctx,"下一頁") }</a>
				}
			</div>
		</section>
	</div>
}

templ SettingsNav(p model.Page) {
	<nav class="settings-tabs" aria-label={ i18n.T(ctx,"管理設定") }>
		<a class={ "settings-tab", templ.KV("active",p.Active=="announcements") } aria-current={ choose(p.Active=="announcements","page","false") } href="/admin/announcements">{ i18n.T(ctx,"公告") }</a>
		<a class={ "settings-tab", templ.KV("active",p.Active=="ai") } aria-current={ choose(p.Active=="ai","page","false") } href="/admin/ai">{ i18n.T(ctx,"AI 指令") }</a>
		<a class={ "settings-tab", templ.KV("active",p.Active=="automation") } aria-current={ choose(p.Active=="automation","page","false") } href="/admin/automation">{ i18n.T(ctx,"自動訊息") }</a>
		<a class={ "settings-tab", templ.KV("active",p.Active=="users") } aria-current={ choose(p.Active=="users","page","false") } href="/admin/users">{ i18n.T(ctx,"使用者") }</a>
		<a class={ "settings-tab", templ.KV("active",p.Active=="departments") } aria-current={ choose(p.Active=="departments","page","false") } href="/admin/departments">{ i18n.T(ctx,"客服分組") }</a>
	</nav>
}

templ AnnouncementCard(item model.Announcement) {
	<article class={ "announcement", "announcement-"+item.Color } aria-label={ i18n.T(ctx,item.ColorLabel())+" · "+item.Title }>
		<span class="announcement-icon" title={ i18n.T(ctx,item.ColorLabel()) }>@Icon(item.Icon())</span>
		<div class="announcement-copy">
			<h2>{ item.Title }</h2>
			<p>{ item.Body }</p>
		</div>
	</article>
}

templ AnnouncementBanners(items []model.Announcement) {
	if len(items)>0 {
		<section class="announcement-banners" aria-label={ i18n.T(ctx,"公告") }>
			for _, item := range items {
				@AnnouncementCard(item)
			}
		</section>
	}
}

templ AnnouncementsSettings(p model.Page) {
	<div class="page-heading"><h1>{ i18n.T(ctx,"公告") }</h1></div>
	@SettingsNav(p)
	if p.Saved {
		<div class="notice success announcement-saved" role="status">
			@Icon("check")
			<span>{ i18n.T(ctx,"已儲存") }</span>
		</div>
	}
	<div class="announcement-settings">
		<section class="account-card announcement-editor">
			<h2>{ i18n.T(ctx,choose(p.Announcement.ID>0,"編輯公告","新增公告")) }</h2>
			<form action={ announcementSaveURL(p.Announcement.ID) } method="post" hx-post={ announcementSaveURL(p.Announcement.ID) } hx-target="#workspace" hx-swap="outerHTML show:none focus-scroll:false" hx-disabled-elt="find button" data-preserve-scroll>
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				if p.Announcement.ID>0 {
					<input type="hidden" name="version" value={ strconv.FormatInt(p.Announcement.Version,10) }/>
				}
				<label class="field">{ i18n.T(ctx,"公告標題") }<input name="title" value={ p.Announcement.Title } maxlength="120" required/></label>
				<label class="field">{ i18n.T(ctx,"內容") }<textarea name="body" rows="4" maxlength="2000" required>{ p.Announcement.Body }</textarea></label>
				<fieldset class="announcement-colors">
					<legend>{ i18n.T(ctx,"訊息類型") }</legend>
					<div class="announcement-color-options">
						for _, color := range []string{"blue","green","red"} {
							<label class={ "announcement-color", "announcement-"+color }>
								<input type="radio" name="color" value={ color } checked?={ p.Announcement.Color==color } required/>
								<span class="announcement-choice">
									@Icon((model.Announcement{Color:color}).Icon())
									<span class="announcement-choice-label">{ i18n.T(ctx,(model.Announcement{Color:color}).ColorLabel()) }</span>
								</span>
							</label>
						}
					</div>
				</fieldset>
				<label class="announcement-enabled"><input type="checkbox" name="enabled" value="1" checked?={ p.Announcement.Enabled }/>{ i18n.T(ctx,"發布公告") }</label>
				<div class="announcement-actions">
					<button type="submit" class="button primary">{ i18n.T(ctx,choose(p.Announcement.ID>0,"儲存變更","新增公告")) }</button>
					if p.Announcement.ID>0 {
						<a class="button secondary" href="/admin/announcements">{ i18n.T(ctx,"取消") }</a>
					}
				</div>
			</form>
		</section>
		<div class="announcement-management-list">
			for _, item := range p.ManagedAnnouncements {
				<section class="announcement-management-item">
					@AnnouncementCard(item)
					<div class="announcement-management-footer">
						<span class={ "announcement-publication", templ.KV("published",item.Enabled) }>{ i18n.T(ctx,choose(item.Enabled,"已發布","已停用")) }</span>
						<div class="announcement-actions">
							<a class="button secondary" href={ templ.SafeURL("/admin/announcements/"+strconv.FormatInt(item.ID,10)) }>{ i18n.T(ctx,"編輯") }</a>
							@AnnouncementAction(p,item,choose(item.Enabled,"disable","publish"),choose(item.Enabled,"停用","發布"))
							<details class="announcement-delete"><summary class="button secondary">{ i18n.T(ctx,"刪除") }</summary><div class="announcement-delete-confirm">@AnnouncementAction(p,item,"delete","確認刪除")</div></details>
						</div>
					</div>
				</section>
			}
			if len(p.ManagedAnnouncements)==0 {
				<p class="field-hint">{ i18n.T(ctx,"尚無公告") }</p>
			}
		</div>
	</div>
}

templ AnnouncementAction(p model.Page,item model.Announcement,action,label string) {
	<form method="post" action={ "/admin/announcements/"+strconv.FormatInt(item.ID,10)+"/"+action } hx-post={ "/admin/announcements/"+strconv.FormatInt(item.ID,10)+"/"+action } hx-target="#workspace" hx-swap="outerHTML show:none focus-scroll:false" hx-disabled-elt="find button" data-preserve-scroll>
		<input type="hidden" name="csrf" value={ p.CSRF }/>
		<input type="hidden" name="version" value={ strconv.FormatInt(item.Version,10) }/>
		<button class={ "button", "secondary", templ.KV("danger",action=="delete") } type="submit">{ i18n.T(ctx,label) }</button>
	</form>
}

func announcementSaveURL(id int64) string {
	if id>0 { return "/admin/announcements/"+strconv.FormatInt(id,10)+"/update" }
	return "/admin/announcements"
}

templ Notifications(p model.Page) {
	<div class="page-heading"><h1>{ i18n.T(ctx,"通知") }</h1>
		if p.UnreadNotifications>0 {
			<form method="post" action="/notifications/read"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="button secondary" type="submit">{ i18n.T(ctx,"全部標為已讀") }</button></form>
		}
	</div>
	<div class="notification-list">
		for _, item := range p.Notifications {
			<form method="post" action={ "/notifications/"+strconv.FormatInt(item.ID,10)+"/read" }>
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				<button class={ "notification-item", templ.KV("unread",item.ReadAt==nil) } type="submit">
					@Icon(choose(item.Kind=="auto_closed" || item.Kind=="closed","check","clock"))
					<span class="notification-copy">
						<strong>{ i18n.T(ctx,choose(item.Kind=="auto_closed","客服單已自動結案",choose(item.Kind=="closed","客服單已結案","客服單已解決"))) }</strong>
						<span class="notification-subject">{ fmt.Sprintf("#%04d",item.TicketID) } · { item.Subject }</span>
						if item.Kind=="solved" && item.AutoCloseAt!=nil {
							<span class="field-hint">{ i18n.T(ctx,"預計結案") } <time datetime={ item.AutoCloseAt.Format(time.RFC3339) } data-local-time="full" data-timezone-inline>{ item.AutoCloseAt.UTC().Format("2006/01/02 15:04") } UTC</time></span>
						}
					</span>
					<time class="notification-time" datetime={ item.CreatedAt.Format(time.RFC3339) } data-local-time="short" data-timezone-inline>{ item.CreatedAt.UTC().Format("01/02 15:04") } UTC</time>
				</button>
			</form>
		}
		if len(p.Notifications)==0 {
			<p class="notification-empty">{ i18n.T(ctx,"目前沒有通知") }</p>
		}
	</div>
	<div class="pagination">
		if p.Page>1 {
			<a href={ templ.SafeURL("/notifications?page="+strconv.Itoa(p.Page-1)) }>{ i18n.T(ctx,"上一頁") }</a>
		}
		if p.HasNext {
			<a href={ templ.SafeURL("/notifications?page="+strconv.Itoa(p.Page+1)) }>{ i18n.T(ctx,"下一頁") }</a>
		}
	</div>
}

templ Departments(p model.Page) {
	<div class="page-heading"><h1>{ i18n.T(ctx,"客服分組") }</h1></div>
	@SettingsNav(p)
	if p.Saved {
		<div class="notice success" role="status">{ i18n.T(ctx,"已儲存") }</div>
	}
	if !p.MailEnabled {
		<p class="field-hint department-mail-note">{ i18n.T(ctx,"SMTP 尚未設定，技術通知暫存 7 天。") }</p>
	}
	<div class="department-settings">
		for _, person := range p.Staff {
			<form class="department-member" method="post" action={ "/admin/departments/"+strconv.FormatInt(person.ID,10) }>
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				<div class="department-member-name"><strong>{ person.Name }</strong><span>{ person.Email }</span></div>
				<div class="department-options">
					for _, department := range model.Departments {
						<label><input type="checkbox" name="departments" value={ department.Category } checked?={ person.InDepartment(department.Category) }/>{ i18n.T(ctx,department.Name) }</label>
					}
				</div>
				<button class="button secondary" type="submit">{ i18n.T(ctx,"儲存") }</button>
			</form>
		}
		if len(p.Staff)==0 {
			<p class="field-hint">{ i18n.T(ctx,"目前沒有客服。") }</p>
		}
	</div>
}

templ AssignmentButton(p model.Page, person model.User, self bool) {
	<form class="assignment-action" method="post" action={ ticketURL(p,p.Ticket.ID)+"/assign" } hx-post={ ticketURL(p,p.Ticket.ID)+"/assign" } hx-target="#ticket-sidebar" hx-select="#ticket-sidebar" hx-select-oob="#detail-status" hx-swap="outerHTML show:none" hx-disabled-elt="find button">
		<input type="hidden" name="csrf" value={ p.CSRF }/>
		<input type="hidden" name="version" value={ strconv.FormatInt(p.Ticket.Version,10) }/>
		<input type="hidden" name="assignee_id" value={ strconv.FormatInt(person.ID,10) }/>
		<button class={ "button", "secondary", "assignment-person", templ.KV("assigned",teamHas(p.Ticket,person.ID)) } type="submit" aria-pressed={ choose(teamHas(p.Ticket,person.ID),"true","false") }>
			if teamHas(p.Ticket,person.ID) {
				@Icon("check")
			} else {
				@Icon("plus")
			}
			{ assignmentLabel(ctx,p.Ticket,person,self) }
		</button>
	</form>
}

templ AssignmentPanel(p model.Page) {
	<section class="assignment-panel" aria-label={ i18n.T(ctx,"指派客服") }>
		<h3>{ i18n.T(ctx,"指派客服") }</h3>
		@AssignmentButton(p,p.User,true)
		for _, department := range departmentOrder(p.Ticket.Category) {
			if hasDepartmentStaff(p.Staff,department.Category,p.User.ID) {
				<div class="assignment-group">
					<h4>{ i18n.T(ctx,department.Name) }</h4>
					for _, person := range p.Staff {
						if person.ID!=p.User.ID && person.InDepartment(department.Category) {
							@AssignmentButton(p,person,false)
						}
					}
				</div>
			}
		}
		if hasUngroupedStaff(p.Staff,p.User.ID) {
			<div class="assignment-group">
				<h4>{ i18n.T(ctx,"未分組") }</h4>
				for _, person := range p.Staff {
					if person.ID!=p.User.ID && len(person.Departments)==0 {
						@AssignmentButton(p,person,false)
					}
				}
			</div>
		}
		if !hasOtherStaff(p.Staff,p.User.ID) {
			<p class="assignment-empty">{ i18n.T(ctx,"目前沒有其他客服可指派") }</p>
		}
	</section>
}

templ Users(p model.Page) {
	<div class="page-heading"><h1>{ i18n.T(ctx,"使用者") }</h1></div>
	@SettingsNav(p)
	<section class="ticket-panel users-panel">
		<form class="users-search" method="get" action="/admin/users">
			<label class="field">{ i18n.T(ctx,"搜尋名稱或電子郵件") }<input name="q" value={ p.Query } maxlength="100"/></label>
			<button class="button secondary">{ i18n.T(ctx,"搜尋") }</button>
		</form>
		<div class="users-table-wrap"><table class="users-table"><thead><tr><th>{ i18n.T(ctx,"名稱") }</th><th>{ i18n.T(ctx,"電子郵件") }</th><th>{ i18n.T(ctx,"角色") }</th><th>{ i18n.T(ctx,"最近登入") }</th></tr></thead><tbody>
			for _, user := range p.Users {
				<tr><td>{ user.User.Name }</td><td>{ user.User.Email }</td><td>{ i18n.T(ctx,model.RoleLabel(user.User.Role)) }</td><td>
					if user.LastLogin != nil {
						<time datetime={ user.LastLogin.Format("2006-01-02T15:04:05Z07:00") } data-local-time="short" data-timezone-inline>{ user.LastLogin.UTC().Format("01/02 15:04") } UTC</time>
					} else {
						<span class="field-hint">{ i18n.T(ctx,"尚無紀錄") }</span>
					}
				</td></tr>
			}
		</tbody></table></div>
		if len(p.Users)==0 {
			<p class="users-empty">{ i18n.T(ctx,"沒有符合條件的使用者") }</p>
		}
		<div class="pagination">
			if p.Page>1 {
				<a href={ templ.SafeURL(usersPageURL(p.Query,p.Page-1)) }>{ i18n.T(ctx,"上一頁") }</a>
			}
			if p.HasNext {
				<a href={ templ.SafeURL(usersPageURL(p.Query,p.Page+1)) }>{ i18n.T(ctx,"下一頁") }</a>
			}
		</div>
	</section>
}

templ List(p model.Page) {
	<div class="page-heading">
		<h1>{ i18n.T(ctx,choose(p.Admin,"客服工作台","我的客服單")) }</h1>
		<a class="button primary" href="/tickets/new">
			@Icon("plus")
			{ i18n.T(ctx,"建立客服單") }
		</a>
	</div>
	<section class="ticket-panel" aria-label={ i18n.T(ctx,"客服單列表") }>
		<nav class="phase-tabs" aria-label={ i18n.T(ctx,"客服單完成狀態") }>
			<a class={ "phase-tab", templ.KV("active",p.Phase=="active") } href={ templ.SafeURL(phaseURL(p,"active")) } hx-get={ phaseURL(p,"active") } hx-target="#workspace" hx-swap="outerHTML" hx-push-url="true">{ i18n.T(ctx,"未完成") } <span>{ strconv.Itoa(p.Counts.All-p.Counts.Solved-p.Counts.Closed) }</span></a>
			<a class={ "phase-tab", templ.KV("active",p.Phase=="done") } href={ templ.SafeURL(phaseURL(p,"done")) } hx-get={ phaseURL(p,"done") } hx-target="#workspace" hx-swap="outerHTML" hx-push-url="true">{ i18n.T(ctx,"已完成") } <span>{ strconv.Itoa(p.Counts.Solved+p.Counts.Closed) }</span></a>
		</nav>
		<div class="list-toolbar">
			<nav class="tabs" aria-label={ i18n.T(ctx,"客服單狀態篩選") }>
				for _, f := range statusFilters(p) {
					<a class={ "tab", templ.KV("active",p.Filter==f.Value) } aria-current={ choose(p.Filter == f.Value, "page", "false") } href={ templ.SafeURL(filterURL(p, f.Value, 1)) } hx-get={ filterURL(p, f.Value, 1) } hx-target="#workspace" hx-swap="outerHTML" hx-push-url="true">
						{ i18n.T(ctx,f.Label) }
						<span class="tab-count" aria-hidden="true">{ strconv.Itoa(f.Count) }</span>
					</a>
				}
			</nav>
			<form class="list-query" action={ listURL(p) } method="get" hx-get={ listURL(p) } hx-target="#workspace" hx-swap="outerHTML" hx-push-url="true" role="search">
				if p.Admin {
					<select name="assigned" aria-label={ i18n.T(ctx,"負責人篩選") } class="assignment-filter" data-auto-submit>
						<option value="">{ i18n.T(ctx,"全部負責人") }</option>
						<option value="mine" selected?={ p.Assignment=="mine" }>{ i18n.T(ctx,"指派給我") }</option>
						<option value="unassigned" selected?={ p.Assignment=="unassigned" }>{ i18n.T(ctx,"未指派") }</option>
					</select>
				}
				<select name="sort" aria-label={ i18n.T(ctx,"時間排序") } class="sort-filter" data-auto-submit>
					<option value="updated_desc" selected?={ p.Sort=="" || p.Sort=="updated_desc" }>{ i18n.T(ctx,"最近更新") }</option>
					<option value="updated_asc" selected?={ p.Sort=="updated_asc" }>{ i18n.T(ctx,"最早更新") }</option>
					<option value="created_desc" selected?={ p.Sort=="created_desc" }>{ i18n.T(ctx,"最新建立") }</option>
					<option value="created_asc" selected?={ p.Sort=="created_asc" }>{ i18n.T(ctx,"最早建立") }</option>
				</select>
				<div class="search">
					<input aria-label={ i18n.T(ctx,"搜尋客服單主旨或編號") } name="q" value={ p.Query } placeholder={ i18n.T(ctx,"搜尋主旨或編號") } maxlength="100"/>
					<button type="submit" class="icon-button" aria-label={ i18n.T(ctx,"搜尋") }>
						@Icon("search")
					</button>
				</div>
				<input type="hidden" name="status" value={ p.Filter }/>
				<input type="hidden" name="phase" value={ p.Phase }/>
				if p.Admin {
					<input type="hidden" name="priority" value={ p.PriorityFilter }/>
				}
			</form>
		</div>
		if p.Admin {
			<nav class="priority-tabs" aria-label={ i18n.T(ctx,"客服單優先級篩選") }>
				for _, item:=range []struct{Value,Label string}{{"","全部優先級"},{"urgent","緊急"},{"normal","標準"}} {
					<a class={ "priority-tab", templ.KV("active",p.PriorityFilter==item.Value) } href={ templ.SafeURL(priorityURL(p,item.Value)) } hx-get={ priorityURL(p,item.Value) } hx-target="#workspace" hx-swap="outerHTML" hx-push-url="true">{ i18n.T(ctx,item.Label) }</a>
				}
			</nav>
		}
		if len(p.Tickets)==0 {
			<div class="empty-state">
				<h2>{ i18n.T(ctx,choose(p.Query!="" || p.Filter!="" || p.PriorityFilter!="" || p.Assignment!="","沒有符合條件的客服單","尚無客服單")) }</h2>
				if p.Query!="" || p.Filter!="" || p.PriorityFilter!="" || p.Assignment!="" {
					<a class="button secondary" href={ templ.SafeURL(listURL(p)) }>{ i18n.T(ctx,"清除篩選") }</a>
				}
			</div>
		} else {
			<div class="table-scroll">
				<table class={ templ.KV("admin-ticket-table",p.Admin) }>
					<thead><tr>
						<th scope="col">{ i18n.T(ctx,"主旨") }</th>
						if p.Admin {
							<th scope="col">{ i18n.T(ctx,"人員") }</th>
						}
						<th scope="col">{ i18n.T(ctx,"狀態") }</th><th scope="col">{ i18n.T(ctx,"類別") }</th><th scope="col">{ i18n.T(ctx,"優先級") }</th><th scope="col">{ i18n.T(ctx,"更新時間") } <span class="timezone" data-timezone-label>UTC</span></th>
					</tr></thead>
					<tbody>
						for _, t := range p.Tickets {
							<tr data-ticket-row>
								<td>
									<div class="ticket-main-content">
									<a class="ticket-title" href={ templ.SafeURL(ticketURL(p, t.ID)) }>
										<span class="ticket-id">{ fmt.Sprintf("#%04d",t.ID) }</span>
										<strong>{ t.Subject }</strong>
									</a>
									<div class="ticket-mobile-meta">
										@Priority(t.Priority)
										<time datetime={ t.UpdatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="short" data-timezone-inline>{ t.UpdatedAt.UTC().Format("01/02 15:04") } UTC</time>
										if p.Admin {
											@Badge(t.Status,p.Admin)
										}
									</div>
								</div>
								</td>
								if p.Admin {
									<td class="ticket-people-cell">
										<div class="ticket-people">
											<div class="ticket-person-group">
												<span class="ticket-person-label">{ i18n.T(ctx,"使用者") }</span>
												<span class="ticket-person">
												if p.Preview {
														<span class="avatar" aria-hidden="true">{ model.Initial(t.Owner) }</span>
													} else {
														<img class="avatar" src={ ticketPersonAvatarURL(t.ID,t.UserID) } alt="" width="32" height="32" loading="lazy"/>
													}
													<strong>{ t.Owner }</strong>
												</span>
											</div>
											<div class="ticket-person-group">
												<span class="ticket-person-label">{ i18n.T(ctx,"負責客服") }</span>
												<span class="ticket-person-list">
													if len(t.Team)==0 {
														<span class="ticket-person-unassigned">{ i18n.T(ctx,"等待指派") }</span>
													} else {
														for _, person:=range t.Team {
															<span class="ticket-person">
																if p.Preview {
																	<span class="avatar" aria-hidden="true">{ model.Initial(person.Name) }</span>
																} else {
																	<img class="avatar" src={ ticketPersonAvatarURL(t.ID,person.ID) } alt="" width="32" height="32" loading="lazy"/>
															}
															<strong>{ person.Name }</strong>
															</span>
														}
													}
												</span>
											</div>
										</div>
									</td>
								}
								<td>
									@TicketBadge(t,p.Admin)
								</td>
								<td class="muted">{ i18n.T(ctx,model.Category(t.Category)) }</td>
								<td>@Priority(t.Priority)</td>
								<td class="date-cell"><time datetime={ t.UpdatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="short">{ t.UpdatedAt.UTC().Format("01/02 15:04") }</time></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if p.Page>1 || p.HasNext {
			<div class="pagination">
				<span>{ pageLabel(ctx,p.Page,false) }</span>
				<div>
					if p.Page>1 {
						<a class="button small secondary" href={ templ.SafeURL(filterURL(p, p.Filter, p.Page-1)) }>{ i18n.T(ctx,"上一頁") }</a>
					}
					if p.HasNext {
						<a class="button small secondary" href={ templ.SafeURL(filterURL(p, p.Filter, p.Page+1)) }>{ i18n.T(ctx,"下一頁") }</a>
					}
				</div>
			</div>
		}
	</section>
}

templ Upload() {
	<div class="upload-field">
		<label for="attachments">{ i18n.T(ctx,"附件") } <span class="field-hint">{ i18n.T(ctx,"選填 · 最多 3 個，每個 10 MB") }</span></label>
		<div class="file-picker">
			<input id="attachments" type="file" name="attachments" multiple accept=".jpg,.jpeg,.png,.webp,.txt,.log,.pdf,.zip" aria-describedby="attachment-types" data-image-worker={ assetURL("image-worker.js") }/>
			<div class="file-picker-display">
				<span class="file-picker-button" aria-hidden="true">{ i18n.T(ctx,"選擇檔案") }</span>
				<output class="file-picker-summary" aria-live="polite" data-file-summary>{ i18n.T(ctx,"未選擇檔案") }</output>
			</div>
		</div>
		<div class="image-previews" data-image-previews aria-label={ i18n.T(ctx,"已選圖片預覽") }></div>
		<p id="attachment-types" class="field-hint">JPG、PNG、WebP、TXT、LOG、PDF、ZIP</p>
	</div>
}

templ NewTicket(p model.Page) {
	<a class="back-link" href="/tickets">
		@Icon("back")
		{ i18n.T(ctx,"客服單列表") }
	</a>
	<div class="page-heading"><h1>{ i18n.T(ctx,"建立客服單") }</h1></div>
	<div class="form-layout">
		<form class="form-panel" method="post" action="/tickets" enctype="multipart/form-data">
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="submission" value={ p.Submission }/>
			<label class="field">
				{ i18n.T(ctx,"客服單主旨") } <span class="required">*</span>
				<input name="subject" value={ p.Ticket.Subject } required maxlength="160" placeholder={ i18n.T(ctx,"簡述問題") }/>
			</label>
			<div class="field-grid">
				<label class="field">
					{ i18n.T(ctx,"問題類別") } <span class="required">*</span>
					<select name="category" required>
						<option value="other" selected?={ p.Ticket.Category=="other" || p.Ticket.Category=="account" }>{ i18n.T(ctx,"一般支援") }</option>
						<option value="billing" selected?={ p.Ticket.Category=="billing" }>{ i18n.T(ctx,"帳務支援") }</option>
						<option value="technical" selected?={ p.Ticket.Category=="technical" }>{ i18n.T(ctx,"技術支援") }</option>
					</select>
				</label>
				<label class="field">
					{ i18n.T(ctx,"優先級") }
					<select name="priority" class="priority-choice">
						<option value="normal" selected?={ p.Ticket.Priority=="normal" }>{ i18n.T(ctx,"標準") }</option>
						<option value="urgent" selected?={ p.Ticket.Priority=="urgent" }>{ i18n.T(ctx,"緊急") }</option>
					</select>
				</label>
			</div>
			<label class="field">
				{ i18n.T(ctx,"問題描述") } <span class="required">*</span>
				<textarea name="body" required maxlength="20000" rows="8" placeholder={ i18n.T(ctx,"問題內容、發生時間或錯誤訊息") }>{ p.DraftBody }</textarea>
			</label>
			<label class="field">
				{ i18n.T(ctx,"參與者（選填）") }
				<input type="email" name="participants" multiple maxlength="5120" value={ p.DraftParticipants } placeholder="name@example.com"/>
				<span class="field-hint">{ i18n.T(ctx,"輸入 Email，多位參與者請以逗號分隔。") }</span>
			</label>
			if p.AIEnabled {
				<p class="field-hint ai-disclosure">{ i18n.T(ctx,"AI 會讀取主旨及問題描述並回覆；公開訊息會傳送至 OpenAI。附件不會傳送。可隨時轉真人客服。") }</p>
			}
			@Upload()
			<div class="form-actions">
				<a class="button secondary" href="/tickets">{ i18n.T(ctx,"取消") }</a>
				<button type="submit" class="button primary">
					{ i18n.T(ctx,"送出客服單") }
				</button>
			</div>
		</form>
	</div>
}

templ Detail(p model.Page) {
	<a class="back-link" href={ listURL(p) }>
		@Icon("back")
		{ i18n.T(ctx,"客服單列表") }
	</a>
	<div class="page-heading detail-heading">
		<div>
			<div class="ticket-reference">
				{ fmt.Sprintf("#%04d",p.Ticket.ID) }
			</div>
			<h1>
				{ p.Ticket.Subject }
			</h1>
			<p>
				{ i18n.T(ctx,"建立於") } <time datetime={ p.Ticket.CreatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="full" data-timezone-inline>{ p.Ticket.CreatedAt.UTC().Format("2006/01/02 15:04") } UTC</time> · { p.Ticket.Owner }
			</p>
		</div>
		<div id="detail-status">@TicketBadge(p.Ticket,p.Admin)</div>
	</div>
	<div class="detail-layout">
		<section class="conversation-panel" aria-label={ i18n.T(ctx,"客服單對話") }>
			if p.Ticket.Status=="solved" {
				<div class="auto-close-notice" role="status">
					<p class="resolution-heading">
						<span>{ i18n.T(ctx,"客服單已標記為") }</span>
						@Badge("solved",p.Admin)
					</p>
					if p.Ticket.AutoCloseAt!=nil {
						<p class="field-hint">{ i18n.T(ctx,"預計結案") } <time datetime={ p.Ticket.AutoCloseAt.Format(time.RFC3339) } data-local-time="full" data-timezone-inline>{ p.Ticket.AutoCloseAt.UTC().Format("2006/01/02 15:04") } UTC</time></p>
					}
					if !p.Admin {
						<p class="field-hint">{ i18n.T(ctx,"仍需協助時，直接回覆即可繼續處理。") }</p>
					}
				</div>
			} else if p.Ticket.Status=="closed" && p.Ticket.AutoClosedAt!=nil {
				<div class="auto-close-notice" role="status"><p>{ i18n.T(ctx,"此客服單已於") } <time datetime={ p.Ticket.AutoClosedAt.Format(time.RFC3339) } data-local-time="full" data-timezone-inline>{ p.Ticket.AutoClosedAt.UTC().Format("2006/01/02 15:04") } UTC</time> { i18n.T(ctx,"自動結案。") }</p></div>
			}
			<div class="panel-heading">
				<h2>{ i18n.T(ctx,"對話記錄") }</h2>
				<span class="muted text-xs" data-timezone-label>UTC</span>
			</div>
			if p.HasMoreMessages || p.MessagePage > 1 {
				<div class="pagination">
					<span>{ pageLabel(ctx,p.MessagePage,true) }</span>
					<div>
						if p.MessagePage > 1 {
							<a href={ templ.SafeURL(ticketURL(p, p.Ticket.ID) + "?messages=" + strconv.Itoa(p.MessagePage-1)) } class="button small secondary">{ i18n.T(ctx,"較新訊息") }</a>
						}
						if p.HasMoreMessages {
							<a href={ templ.SafeURL(ticketURL(p, p.Ticket.ID) + "?messages=" + strconv.Itoa(p.MessagePage+1)) } class="button small secondary">{ i18n.T(ctx,"較早訊息") }</a>
						}
					</div>
				</div>
			}
			<div id="conversation-activity" hx-get={ templ.SafeURL(ticketURL(p,p.Ticket.ID)) } hx-trigger={ choose(p.Ticket.AssistanceMode=="ai" && (p.Ticket.Status=="new" || p.Ticket.Status=="open") && p.MessagePage==1,"every 5s","ai-inactive") } hx-select="#conversation-activity" hx-select-oob={ choose(p.Admin,"#detail-status","#detail-status,#ticket-update-version") } hx-disinherit="hx-select hx-select-oob" hx-swap="outerHTML">
			<div class="messages">
				for _, m := range p.Messages {
					if m.Source=="system" {
						<article class="message-system">
							@Icon("category-"+p.Ticket.Category)
							<span><strong>{ authorName(ctx,m) }</strong> { systemMessage(ctx,m.Body) }</span>
							<time datetime={ m.CreatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="short">{ m.CreatedAt.UTC().Format("01/02 15:04") }</time>
						</article>
					} else {
					<article class={ "message", templ.KV("internal-note",m.Internal), templ.KV("message-automation",m.Source=="automation"), templ.KV("message-ai",m.Source=="ai"), templ.KV("message-staff",m.Role!="user" && m.Source!="automation" && m.Source!="ai" && !m.Internal) }>
						<div class="message-header">
							if m.Source == "ai" {
								<span class="avatar automated-avatar" aria-hidden="true">
									@Icon("assistant")
								</span>
							} else if m.Source == "automation" {
								<span class="avatar automated-avatar" aria-hidden="true">
									@Icon("clock")
								</span>
							} else if p.Preview || m.AuthorID == 0 {
								<span class="avatar" aria-hidden="true">{ model.Initial(m.Author) }</span>
							} else {
								<img class="avatar" src={ avatarURL(p.Ticket.ID, m.AuthorID) } alt="" width="30" height="30" loading="lazy" decoding="async"/>
							}
							<div>
								<strong>
									{ authorName(ctx,m) }
								</strong>
								<span class="author-role">
									{ i18n.T(ctx,choose(m.Source=="ai","AI 回覆",choose(m.Source=="automation","自動回覆",choose(m.Internal,"內部備註 · 僅客服可見",choose(m.Role!="user","支援團隊","客戶"))))) }
								</span>
							</div>
							<div class="message-time">
								<time datetime={ m.CreatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="short">{ m.CreatedAt.UTC().Format("01/02 15:04") }</time>
								<span class="relative-time" data-relative-time={ m.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }></span>
							</div>
						</div>
						<div class="message-body">
							{ messageBody(ctx,m) }
						</div>
						if len(m.Attachments)>0 {
							<div class="attachment-list">
				for _, a := range m.Attachments {
					if strings.HasPrefix(a.MIME,"image/") {
						<div class="attachment image-attachment">
							<a class="image-preview-link" href={ templ.SafeURL(fmt.Sprintf("/attachments/%d/preview", a.ID)) } data-image-preview data-image-name={ a.Name } data-original-url={ fmt.Sprintf("/attachments/%d", a.ID) } target="_blank" rel="noopener" aria-label={ i18n.T(ctx,"預覽") + " " + a.Name }>
								<img src={ templ.SafeURL(fmt.Sprintf("/attachments/%d/preview", a.ID)) } alt="" loading="lazy" decoding="async"/>
							</a>
							<a class="attachment-file-name" href={ templ.SafeURL(fmt.Sprintf("/attachments/%d", a.ID)) } title={ i18n.T(ctx,"下載原檔") }>{ a.Name }<small>{ fmt.Sprintf("%.1f KB",float64(a.Size)/1024) }</small></a>
						</div>
					} else {
						<a href={ templ.SafeURL(fmt.Sprintf("/attachments/%d", a.ID)) } class="attachment">
							@Icon("file")
							<span>
								{ a.Name }
								<small>
									{ fmt.Sprintf("%.1f KB",float64(a.Size)/1024) }
								</small>
							</span>
							@Icon("arrow")
						</a>
					}
								}
							</div>
						}
					</article>
					}
				}
			</div>
			if p.Ticket.AssistanceMode == "ai" && !p.Admin && p.Ticket.Status != "closed" && p.Ticket.Status!="solved" {
				<div class="assistance-panel">
					<div class="assistance-copy">
						<strong>{ i18n.T(ctx,choose(p.Ticket.Status=="waiting","AI 助理已回覆","AI 助理處理中")) }</strong>
						if p.Ticket.Status=="waiting" {
							<span class="field-hint">{ i18n.T(ctx,"問題解決了嗎？") }</span>
						}
						<span class="field-hint">{ i18n.T(ctx,"繼續回覆會由 AI 接續處理。") }</span>
					</div>
					if p.Ticket.UserID==p.User.ID {
						<div class="assistance-actions">
							if p.Ticket.Status=="waiting" {
								<form method="post" action={ fmt.Sprintf("/tickets/%d/resolve",p.Ticket.ID) } hx-post={ fmt.Sprintf("/tickets/%d/resolve",p.Ticket.ID) } hx-target="#workspace" hx-swap="outerHTML">
									<input type="hidden" name="csrf" value={ p.CSRF }/>
									<input type="hidden" name="version" value={ strconv.FormatInt(p.Ticket.Version,10) }/>
									<button class="button secondary close-action" type="submit">
										@Icon("check")
										{ i18n.T(ctx,"已解決") }
									</button>
								</form>
							}
							<form method="post" action={ fmt.Sprintf("/tickets/%d/handoff",p.Ticket.ID) }>
								<input type="hidden" name="csrf" value={ p.CSRF }/>
								<button class="button secondary handoff-action" type="submit">{ i18n.T(ctx,"轉真人客服") }</button>
							</form>
						</div>
					}
				</div>
			} else if p.Ticket.HandoffAt != nil && !p.Admin && p.Ticket.Status!="solved" && p.Ticket.Status!="closed" {
				<div class="assistance-panel">{ i18n.T(ctx,"已轉交真人客服，等待回覆") }</div>
			}
			</div>
			if p.Ticket.Status == "closed" && !p.Admin {
				<div class="closed-notice">
					@Icon("check")
					{ i18n.T(ctx,"此客服單已結案。如需繼續討論，請先重新開啟。") }
				</div>
				if p.DraftBody!="" {
					<label class="field">{ i18n.T(ctx,"未送出的回覆") }<textarea readonly rows="5">{ p.DraftBody }</textarea></label>
				}
			} else {
				if p.ServiceNotice!=nil {
					<div class="service-notice" role="note">
						<div class="service-notice-heading">
							@Icon("clock")
							<strong>{ i18n.T(ctx,choose(p.ServiceNotice.Kind=="leave","客服休假中","目前非客服服務時間")) }</strong>
						</div>
						<p class="service-notice-body">{ p.ServiceNotice.Body }</p>
					</div>
				}
				<form class="reply-form" method="post" action={ ticketURL(p, p.Ticket.ID) + "/reply" } enctype="multipart/form-data" hx-post={ ticketURL(p, p.Ticket.ID) + "/reply" } hx-encoding="multipart/form-data" hx-target="#workspace" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']">
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					<input type="hidden" name="submission" value={ p.Submission }/>
					<label class="field" for="reply">{ i18n.T(ctx,"回覆") }</label>
					<textarea id="reply" name="body" required maxlength="20000" rows="5" placeholder={ i18n.T(ctx,"輸入回覆…") }>{ p.DraftBody }</textarea>
					if p.User.Role=="admin" && p.User.Signature!="" {
						<p class="field-hint">{ i18n.T(ctx,"公開回覆會自動附上簽名檔") }</p>
					}
					@Upload()
					<div class="form-actions">
						if p.Admin {
							<label class="checkbox-label">
								<input type="checkbox" name="internal" value="true" checked?={ p.DraftInternal }/>{ i18n.T(ctx,"內部備註（僅客服可見）") }
							</label>
						}
						<button class="button primary" type="submit">
							{ i18n.T(ctx,"送出回覆") }
						</button>
					</div>
				</form>
			}
		</section>
		<aside class="ticket-sidebar" id="ticket-sidebar">
			<section class="metadata-panel">
				<h2>{ i18n.T(ctx,"客服單資訊") }</h2>
				<dl>
					<dt>{ i18n.T(ctx,"客服單編號") }</dt>
					<dd class="ticket-info-id">{ fmt.Sprintf("#%04d",p.Ticket.ID) }</dd>
					<dt>{ i18n.T(ctx,"問題類別") }</dt>
					<dd>
						<span class="category-value">
							@Icon("category-"+p.Ticket.Category)
							{ i18n.T(ctx,model.Category(p.Ticket.Category)) }
						</span>
					</dd>
					<dt>{ i18n.T(ctx,"優先級") }</dt>
					<dd>
						@Priority(p.Ticket.Priority)
					</dd>
					<dt>{ i18n.T(ctx,"負責客服") }</dt>
					<dd>{ i18n.T(ctx,teamLabel(p.Ticket)) }</dd>
					if p.Ticket.AssistanceMode == "ai" {
						<dt>{ i18n.T(ctx,"處理方式") }</dt><dd>{ i18n.T(ctx,"AI 助理") }</dd>
					} else if p.Ticket.HandoffAt != nil {
						<dt>{ i18n.T(ctx,"處理方式") }</dt><dd>{ i18n.T(ctx,"真人客服") }</dd>
					}
					<dt>{ i18n.T(ctx,"建立時間") }</dt>
					<dd><time datetime={ p.Ticket.CreatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="short" data-timezone-inline>{ p.Ticket.CreatedAt.UTC().Format("01/02 15:04") } UTC</time></dd>
					<dt>{ i18n.T(ctx,"最近更新") }</dt>
					<dd><time datetime={ p.Ticket.UpdatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="short" data-timezone-inline>{ p.Ticket.UpdatedAt.UTC().Format("01/02 15:04") } UTC</time></dd>
				</dl>
				if p.Admin || p.Ticket.UserID==p.User.ID {
				<form action={ ticketURL(p, p.Ticket.ID) + "/update" } method="post" hx-post={ ticketURL(p, p.Ticket.ID) + "/update" } hx-target="#workspace" hx-swap="outerHTML show:none focus-scroll:false" hx-disabled-elt="find button" data-preserve-scroll>
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					<input id="ticket-update-version" type="hidden" name="version" value={ strconv.FormatInt(p.Ticket.Version, 10) }/>
					if p.Admin {
						<label class="field">
							{ i18n.T(ctx,"問題類別") }
							<select name="category">
								for _, category := range []string{"other","billing","technical"} {
									<option value={ category } selected?={ p.Ticket.Category==category || (category=="other" && p.Ticket.Category=="account") }>{ i18n.T(ctx,model.Category(category)) }</option>
								}
							</select>
						</label>
						<label class="field">
							{ i18n.T(ctx,"更新狀態") }
							<select name="status">
								for _, s := range []string{"new","open","waiting","on_hold","solved","closed"} {
									<option value={ s } selected?={ p.Ticket.Status==s }>
										{ i18n.T(ctx,model.StatusForViewer(s,true)) }
									</option>
								}
							</select>
						</label>
						<label class="field">
							{ i18n.T(ctx,"優先級") }
							<select name="priority">
								for _, s := range []string{"normal","urgent"} {
									<option value={ s } selected?={ p.Ticket.Priority==s }>
										{ i18n.T(ctx,model.Priority(s)) }
									</option>
								}
							</select>
						</label>
						for _, person := range p.Ticket.Team {
							<input type="hidden" name="assignees" value={ strconv.FormatInt(person.ID,10) }/>
						}
						<button class="button primary full-width">{ i18n.T(ctx,"儲存變更") }</button>
					} else if p.Ticket.Status == "closed" {
						<input type="hidden" name="status" value="new"/>
						<button class="button secondary full-width">{ i18n.T(ctx,"重新開啟客服單") }</button>
					} else {
						<input type="hidden" name="status" value="closed"/>
						<button class="button secondary close-action full-width">
							@Icon("check")
							{ i18n.T(ctx,"結案") }
						</button>
					}
				</form>
				}
				if p.Admin {
					@AssignmentPanel(p)
				}
			</section>
			if p.Ticket.UserID==p.User.ID || p.Admin || len(p.Invites)>0 {
				<section class="invite-panel">
					<h2>{ i18n.T(ctx,"參與者") }</h2>
					if p.Ticket.UserID==p.User.ID {
						<form method="post" action={ fmt.Sprintf("/tickets/%d/invite",p.Ticket.ID) }>
							<input type="hidden" name="csrf" value={ p.CSRF }/>
							<label class="field">{ i18n.T(ctx,"以 Email 邀請") }<input type="email" name="email" maxlength="254" required placeholder="name@example.com"/></label>
							<button class="button secondary" type="submit">{ i18n.T(ctx,"邀請") }</button>
						</form>
					}
					<ul class="invite-list">
						for _, participant:= range p.Invites {
							<li>
								<span class="participant-identity">
									<strong>{ participant.Email }</strong>
								</span>
								if p.Ticket.UserID==p.User.ID {
									<form method="post" action={ fmt.Sprintf("/tickets/%d/uninvite",p.Ticket.ID) }>
										<input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="email" value={ participant.Email }/>
										<button class="button small secondary" type="submit" aria-label={ i18n.T(ctx,"移除") + " " + participant.Email }>{ i18n.T(ctx,"移除") }</button>
									</form>
								} else if participant.Self {
									<form method="post" action={ fmt.Sprintf("/tickets/%d/leave",p.Ticket.ID) }>
										<input type="hidden" name="csrf" value={ p.CSRF }/>
										<button class="button small secondary" type="submit">{ i18n.T(ctx,"退出客服單") }</button>
									</form>
								}
								</li>
						}
					</ul>
				</section>
			}
			if p.Admin && len(p.Events)>0 {
				<details class="event-history">
					<summary>{ i18n.T(ctx,"操作紀錄") }</summary>
					<ol>
						for _,event:=range p.Events {
							<li><strong>{ event.Actor }</strong><p>{ eventText(ctx,event,p.Staff) }</p><time datetime={ event.CreatedAt.Format("2006-01-02T15:04:05Z07:00") } data-local-time="short" data-timezone-inline>{ event.CreatedAt.UTC().Format("01/02 15:04") } UTC</time></li>
						}
					</ol>
					<span class="field-hint">{ i18n.T(ctx,"最近 20 筆") }</span>
				</details>
			}
		</aside>
	</div>
}

templ SiteFooter() {
	<footer class="site-footer"><a href={ templ.SafeURL(brandOf(ctx).Website) } aria-label={ i18n.T(ctx,brandOf(ctx).SiteLabel) }>© { strconv.Itoa(time.Now().Year()) } { brandOf(ctx).Owner }</a></footer>
}

templ Login(p model.Page) {
	<main id="workspace" class="login-page login-split">
		<section class="login-panel">
			<div class="login-copy">
				<img class="login-logo" src={ assetURL(brandOf(ctx).Icon) } width="44" height="44" alt=""/>
				<h1>{ i18n.T(ctx,brandOf(ctx).SignIn) }</h1>
				<p class="login-lead">{ i18n.T(ctx,"登入後即可建立及追蹤客服單。") }</p>
				<a class="button primary login-action" href="/login">
					@Icon("login")
					<span>{ i18n.T(ctx,"使用 AtomRoute 帳號繼續") }</span>
				</a>
				<p class="login-signup">{ i18n.T(ctx,"還沒有帳號？") }<a href="/signup">{ i18n.T(ctx,"註冊") }</a></p>
			</div>
			<div class="login-visual" aria-hidden="true">
				@LoginGlobe()
			</div>
		</section>
	</main>
}

// LoginGlobe layers the cached dot map under inline routes, which CSS animates.
templ LoginGlobe() {
	<svg class="login-globe" viewBox="0 0 1000 1000" focusable="false">
		for _, layer := range []string{"ocean-far", "ocean-near", "land-edge", "land-far", "land-mid", "land-near"} {
			<use class={ "globe-" + layer } href={ assetURL("globe.svg") + "#" + layer }></use>
		}
		for i, route := range globeRoutes {
			<path class="globe-route" d={ route }></path>
			<path class={ "globe-pulse", "globe-delay-" + strconv.Itoa(i%3) } d={ route } pathLength="100"></path>
		}
		for i, node := range globeNodes {
			<circle class={ "globe-node-ring", "globe-delay-" + strconv.Itoa(i%3) } cx={ node.X } cy={ node.Y } r="7"></circle>
			<circle class="globe-node" cx={ node.X } cy={ node.Y } r="4"></circle>
		}
		<circle class="globe-node-ring globe-hub-ring" cx={ globeHub.X } cy={ globeHub.Y } r="10"></circle>
		<circle class="globe-node globe-hub" cx={ globeHub.X } cy={ globeHub.Y } r="6"></circle>
	</svg>
}

templ Automation(p model.Page) {
	<div class="page-heading"><h1>{ i18n.T(ctx,"自動回覆") }</h1></div>
	@SettingsNav(p)
	if p.Saved {
		<div class="notice success" role="status">{ i18n.T(ctx,"已儲存") }</div>
	}
	<form class="automation-form" method="post" action="/admin/automation">
		<input type="hidden" name="csrf" value={ p.CSRF }/>
		<section class="account-card">
			<h2>{ i18n.T(ctx,"自動結案") }</h2>
			<label class="field">{ i18n.T(ctx,"已解決後幾天結案") }<input class="auto-close-days" type="number" name="auto_close_days" min="0" max="365" step="1" value={ strconv.Itoa(p.Automation.AutoCloseDays) } required/></label>
			<p class="field-hint">{ i18n.T(ctx,"0 表示停用；從標記已解決時起算。回覆後取消倒數，並發出站內通知。") }</p>
			<p class="field-hint">{ i18n.T(ctx,"變更天數也會套用目前已解決的客服單。") }</p>
		</section>
		<section class="account-card">
			<h2>{ i18n.T(ctx,"服務時間") }</h2>
			<label class="field">{ i18n.T(ctx,"時區") }<input name="timezone" value={ p.Automation.Timezone } required/></label>
			<div class="day-list">
				for i, name := range []string{"週一","週二","週三","週四","週五","週六","週日"} {
					<details class="day-schedule" open?={ i==0 }>
						<summary><strong>{ i18n.T(ctx,name) }</strong><span data-day-summary>{ daySummaryLocalized(ctx,p.Automation.Days[i]) }</span></summary>
						<div class="day-schedule-body">
							<label class="automation-toggle"><input type="checkbox" name={ "day_enabled_"+strconv.Itoa(i) } checked?={ p.Automation.Days[i].Enabled }/>{ i18n.T(ctx,"服務日") }</label>
							<div class="range-list" data-range-list data-day={ strconv.Itoa(i) }>
								for _, period := range displayedRanges(p.Automation.Days[i].Ranges) {
									<div class="range-row">
										<label class="field">{ i18n.T(ctx,"開始") }<input type="time" name={ "day_start_"+strconv.Itoa(i) } value={ period.Start }/></label>
										<label class="field">{ i18n.T(ctx,"結束") }<input type="time" name={ "day_end_"+strconv.Itoa(i) } value={ period.End }/></label>
										<button type="button" class="button secondary range-remove" data-range-remove aria-label={ i18n.T(ctx,"移除時段") }>{ i18n.T(ctx,"移除") }</button>
									</div>
								}
							</div>
							<button type="button" class="button secondary range-add" data-range-add data-day={ strconv.Itoa(i) } disabled?={ len(p.Automation.Days[i].Ranges)>=8 }>{ i18n.T(ctx,"新增時段") }</button>
						</div>
					</details>
				}
			</div>
			<template id="range-row-template">
				<div class="range-row">
					<label class="field">{ i18n.T(ctx,"開始") }<input type="time"/></label>
					<label class="field">{ i18n.T(ctx,"結束") }<input type="time"/></label>
					<button type="button" class="button secondary range-remove" data-range-remove aria-label={ i18n.T(ctx,"移除時段") }>{ i18n.T(ctx,"移除") }</button>
				</div>
			</template>
			<p class="field-hint">{ i18n.T(ctx,"各日可設定不同時段；空檔視為非服務時間。") }</p>
		</section>
		<section class="account-card">
			<h2>{ i18n.T(ctx,"臨時休假") }</h2>
			<label class="automation-toggle"><input type="checkbox" name="leave_enabled" checked?={ p.Automation.LeaveEnabled }/>{ i18n.T(ctx,"啟用自動回覆") }</label>
			<div class="leave-time-grid">
				<label class="field">{ i18n.T(ctx,"開始時間") }<input type="datetime-local" name="leave_start" value={ leaveInputTime(p.Automation.LeaveStartAt,p.Automation.Timezone) }/></label>
				<label class="field">{ i18n.T(ctx,"結束時間") }<input type="datetime-local" name="leave_end" value={ leaveInputTime(p.Automation.LeaveEndAt,p.Automation.Timezone) }/></label>
			</div>
			<label class="field">{ i18n.T(ctx,"訊息") }<textarea name="leave_body" rows="4" maxlength="20000">{ p.Automation.LeaveBody }</textarea></label>
			<p class="field-hint">{ i18n.T(ctx,"依上方時區；休假期間的新客服單優先使用此訊息，結束後自動恢復。") }</p>
		</section>
		<section class="account-card">
			<h2>{ i18n.T(ctx,"開單後") }</h2>
			<label class="automation-toggle"><input type="checkbox" name="on_create_enabled" checked?={ p.Automation.OnCreateEnabled }/>{ i18n.T(ctx,"啟用自動回覆") }</label>
			<label class="field">{ i18n.T(ctx,"訊息") }<textarea name="on_create_body" rows="4" maxlength="20000">{ p.Automation.OnCreateBody }</textarea></label>
		</section>
		<section class="account-card">
			<h2>{ i18n.T(ctx,"非服務時間") }</h2>
			<label class="automation-toggle"><input type="checkbox" name="off_hours_enabled" checked?={ p.Automation.OffHoursEnabled }/>{ i18n.T(ctx,"啟用自動回覆") }</label>
			<label class="field">{ i18n.T(ctx,"訊息") }<textarea name="off_hours_body" rows="4" maxlength="20000">{ p.Automation.OffHoursBody }</textarea></label>
			<p class="field-hint">{ i18n.T(ctx,"僅顯示於回覆框上方，不新增對話訊息。") }</p>
		</section>
		<button class="button primary" type="submit">{ i18n.T(ctx,"儲存設定") }</button>
	</form>
}

templ AISettings(p model.Page) {
	<div class="page-heading"><h1>{ i18n.T(ctx,"AI 指令") }</h1></div>
	@SettingsNav(p)
	if p.Saved {
		<div class="notice success" role="status">{ i18n.T(ctx,"已儲存") }</div>
	}
	<form class="ai-settings-form" method="post" action="/admin/ai">
		<input type="hidden" name="csrf" value={ p.CSRF }/>
		<section class="account-card">
			<div class="ai-model-line"><h2>{ i18n.T(ctx,"回覆模型") }</h2><span>{ p.AIModel }</span></div>
			<div class="ai-model-line"><h2>{ i18n.T(ctx,"自動回覆") }</h2><span>{ i18n.T(ctx,choose(p.AIEnabled,"啟用中","未啟用")) }</span></div>
		</section>
		<section class="account-card">
			<h2>{ i18n.T(ctx,"部門系統指令") }</h2>
			<p class="field-hint">{ i18n.T(ctx,"各部門使用自己的完整指令；留空就不送系統指令。") }</p>
			<p class="field-hint">{ i18n.T(ctx,"程式不加入預設或隱藏指令。") }</p>
			<label class="field">{ i18n.T(ctx,"一般支援") }<textarea name="general_prompt" rows="5" maxlength="4000">{ p.AIPrompts.General }</textarea></label>
			<label class="field">{ i18n.T(ctx,"帳務支援") }<textarea name="billing_prompt" rows="5" maxlength="4000">{ p.AIPrompts.Billing }</textarea></label>
			<label class="field">{ i18n.T(ctx,"技術支援") }<textarea name="technical_prompt" rows="5" maxlength="4000">{ p.AIPrompts.Technical }</textarea></label>
		</section>
		<button class="button primary" type="submit">{ i18n.T(ctx,"儲存指令") }</button>
	</form>
}

templ ErrorPage(status int, message string) {
	<!DOCTYPE html>
	<html lang={ i18n.Lang(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ i18n.T(ctx,"操作未完成 · AtomRoute 支援中心") }</title>
			<link rel="icon" type="image/png" href={ assetURL(brandOf(ctx).Icon) }/>
			<script src={ assetURL("theme.js") }></script>
			<link rel="stylesheet" href={ assetURL("app.css") }/>
		</head>
		<body>
			<main class="login-page">
				<section class="login-card">
					<div class="ticket-reference">{ strconv.Itoa(status) }</div>
					<h1>{ i18n.T(ctx,"操作未完成") }</h1>
					<p>
						{ message }
					</p>
					<p>{ i18n.T(ctx,"可返回上一頁繼續編輯。") }</p>
					<a class="button primary" href="/tickets">{ i18n.T(ctx,"客服單列表") }</a>
				</section>
			</main>
			@SiteFooter()
		</body>
	</html>
}

templ AcceptanceLogin(csrf string, message string) {
	<!DOCTYPE html>
	<html lang={ i18n.Lang(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ i18n.T(ctx,"功能驗收登入") }</title>
			<link rel="icon" type="image/png" href={ assetURL(brandOf(ctx).Icon) }/>
			<script src={ assetURL("theme.js") }></script>
			<link rel="stylesheet" href={ assetURL("app.css") }/>
		</head>
		<body>
			<main class="login-page">
				<section class="login-card">
					<h1>{ i18n.T(ctx,"功能驗收登入") }</h1>
					<p>{ i18n.T(ctx,"獨立資料庫，可實際建立與處理客服單。") }</p>
					if message!="" {
						<p role="alert">{ i18n.T(ctx,message) }</p>
					}
					<form method="post" action="/acceptance/login">
						<input type="hidden" name="csrf" value={ csrf }/>
						<label class="field">{ i18n.T(ctx,"驗收身分") }<select name="account"><option value="customer">{ i18n.T(ctx,"客戶 A") }</option><option value="customer2">{ i18n.T(ctx,"客戶 B") }</option><option value="support">{ i18n.T(ctx,"客服") }</option></select></label>
						<label class="field">{ i18n.T(ctx,"驗收密碼") }<input type="password" name="password" autocomplete="current-password" required/></label>
						<button class="button primary full-width">{ i18n.T(ctx,"登入") }</button>
					</form>
				</section>
			</main>
			@SiteFooter()
		</body>
	</html>
}
